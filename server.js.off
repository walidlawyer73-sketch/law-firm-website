// ============================================================================
// server.js - Walid Abo Al-Ela Law Firm
// الخادم الرئيسي - Express + MongoDB + EJS Admin Panel + Contact API
// Main Server - Express + MongoDB + EJS Admin Panel + Contact API
// ============================================================================

// تحميل المتغيرات البيئية من ملف .env
// Load environment variables from .env file
require('dotenv').config();

// استيراد المكتبات الأساسية
// Import core libraries
const express = require('express');
const mongoose = require('mongoose');
const session = require('express-session');
const bcrypt = require('bcryptjs');
const multer = require('multer');
const path = require('path');
const methodOverride = require('method-override');
const nodemailer = require('nodemailer');
const { marked } = require('marked');

// ============================================================================
// استيراد النماذج (الموديلات) من قاعدة البيانات
// Import database models
// ============================================================================
const Page = require('./models/Page');
const BlogPost = require('./models/BlogPost');
const Testimonial = require('./models/Testimonial');
const ContactInfo = require('./models/ContactInfo');
const Contact = require('./models/Contact');
const User = require('./models/User');

// ============================================================================
// استيراد معالج API للاتصال
// Import contact API handler (Vercel serverless function)
// ============================================================================
const contactHandler = require('./api/contact');

// ============================================================================
// تهيئة تطبيق Express
// Initialize Express application
// ============================================================================
const app = express();
const port = process.env.PORT || 3000;

// ============================================================================
// إعداد مكتبة Marked لتحويل Markdown إلى HTML
// Configure Marked for Markdown to HTML conversion
// ============================================================================
marked.setOptions({
    breaks: true,      // تحويل السطر الجديد إلى <br> | Convert \n to <br>
    gfm: true,         // تفعيل GitHub Flavored Markdown | Enable GFM
    headerIds: false,  // عدم إضافة IDs تلقائية للعناوين | No auto IDs
    mangle: false      // عدم تشويش عناوين البريد | Don't mangle emails
});

// ============================================================================
// إعداد ناقل البريد الإلكتروني والتحقق عند بدء التشغيل
// Email transporter setup with startup verification
// ============================================================================
let emailReady = false;

if (process.env.EMAIL_USER && process.env.EMAIL_PASS) {
    // إنشاء ناقل البريد باستخدام SMTP
    // Create mail transporter using SMTP
    const transporter = nodemailer.createTransport({
        host: process.env.EMAIL_HOST || 'smtp.gmail.com',
        port: Number(process.env.EMAIL_PORT) || 587,
        secure: process.env.EMAIL_SECURE === 'true', // true لـ 465, false لـ 587
        auth: {
            user: process.env.EMAIL_USER,
            pass: process.env.EMAIL_PASS
        },
        tls: { rejectUnauthorized: false } // للسماح بشهادات HTTPS
    });

    // التحقق من إعدادات البريد عند بدء التشغيل
    // Verify email configuration on startup
    transporter.verify((error, success) => {
        if (error) {
            console.error('❌ Email configuration error:', error.message);
        } else {
            console.log('✅ Email ready to send');
            emailReady = true;
        }
    });
} else {
    console.warn('⚠️  EMAIL_USER or EMAIL_PASS not set - emails will not be sent');
}

// ============================================================================
// الاتصال بقاعدة بيانات MongoDB
// Connect to MongoDB database
// ============================================================================
mongoose.connect(process.env.MONGODB_URI)
    .then(() => console.log('✅ DB Connected'))
    .catch((err) => console.error('❌ DB Error:', err.message));

// ============================================================================
// خدمة الملفات الثابتة (CSS, JS, Images, HTML)
// Serve static files (CSS, JS, Images, HTML)
// ============================================================================
app.use(express.static('public'));
app.use('/uploads', express.static('uploads'));

// ============================================================================
// مسار API للاتصال - يجب أن يكون قبل body parsers
// Contact API endpoint - MUST be before body parsers
// ============================================================================
app.post('/api/contact', contactHandler);

// ============================================================================
// Middleware لتحليل الطلبات
// Body parsers middleware
// ============================================================================
app.use(express.json());                                    // JSON
app.use(express.urlencoded({ extended: true }));            // Form data
app.use(methodOverride('_method'));                         // PUT/DELETE من HTML

// ============================================================================
// إعداد الجلسات (Sessions)
// Session configuration
// ============================================================================
app.use(session({
    secret: process.env.SESSION_SECRET || 'fallback-secret-change-me',
    resave: false,
    saveUninitialized: false,
    cookie: {
        secure: process.env.NODE_ENV === 'production',      // HTTPS only in production
        httpOnly: true,                                      // منع JavaScript من قراءة الكوكي
        maxAge: 24 * 60 * 60 * 1000                         // 24 ساعة | 24 hours
    }
}));

// ============================================================================
// إعداد محرك العرض EJS للوحة التحكم
// Configure EJS view engine for admin panel
// ============================================================================
app.set('view engine', 'ejs');
app.set('views', path.join(__dirname, 'views'));

// ============================================================================
// إعداد رفع الملفات باستخدام Multer
// File upload configuration with Multer
// ============================================================================
const storage = multer.diskStorage({
    destination: (req, file, cb) => {
        cb(null, 'uploads/');                               // مجلد الحفظ
    },
    filename: (req, file, cb) => {
        // اسم الملف: timestamp + extension
        cb(null, Date.now() + path.extname(file.originalname));
    }
});
const upload = multer({ storage });

// ============================================================================
// Middleware للتحقق من تسجيل الدخول
// Authentication middleware - requires login
// ============================================================================
const requireAuth = (req, res, next) => {
    if (req.session.userId) {
        next();                                              // مسجل دخول - تابع
    } else {
        res.redirect('/admin/login');                       // غير مسجل - اذهب للـ login
    }
};

// ============================================================================
// Middleware للغة لوحة التحكم
// Admin panel language middleware
// ============================================================================
app.use('/admin', (req, res, next) => {
    if (req.query.lang) {
        req.session.adminLang = req.query.lang;             // حفظ اللغة المختارة
    }
    res.locals.lang = req.session.adminLang || 'en';        // اللغة الافتراضية: إنجليزية
    next();
});

// ============================================================================
// دالة مساعدة: عرض صفحة HTML ديناميكية
// Helper: Render dynamic page HTML
// ============================================================================
function renderPageHTML(page, htmlContent, lang) {
    const isAr = lang === 'ar';
    const dir = isAr ? 'rtl' : 'ltr';
    const base = isAr ? '/ar' : '';
    const slug = page.slug.replace(/-ar$/, '');
    const switchUrl = isAr ? '/' + slug : '/ar/' + slug;

    // قاموس الترجمات | Translation dictionary
    const t = {
        home: isAr ? 'الرئيسية' : 'Home',
        about: isAr ? 'من نحن' : 'About',
        services: isAr ? 'الخدمات' : 'Services',
        arbitration: isAr ? 'التحكيم' : 'Arbitration',
        trademark: isAr ? 'العلامات التجارية' : 'Trademark',
        patent: isAr ? 'براءات الاختراع' : 'Patent',
        copyright: isAr ? 'حقوق المؤلف' : 'Copyright',
        litigation: isAr ? 'القضايا' : 'Litigation',
        licensing: isAr ? 'الترخيص والعقود' : 'Licensing',
        allServices: isAr ? 'جميع الخدمات' : 'All Services',
        team: isAr ? 'فريق العمل' : 'Our Team',
        blog: isAr ? 'المدونة' : 'Blog',
        contact: isAr ? 'اتصل بنا' : 'Contact',
        consultation: isAr ? 'استشارة مدفوعة' : 'Paid Consultation',
        portal: isAr ? 'بوابة العميل' : 'Client Portal',
        switchLang: isAr ? 'English' : 'العربية',
        brandName: isAr ? 'وليد أبوالعلا للمحاماة' : 'Walid Abo Al-Ela Law Firm',
        brandSub: isAr ? 'والتحكيم والملكية الفكرية' : 'For Arbitration and Intellectual Property',
        copyright: isAr
            ? `© ${new Date().getFullYear()} وليد أبوالعلا للمحاماة. جميع الحقوق محفوظة.`
            : `© ${new Date().getFullYear()} Walid Abo Al-Ela Law Firm. All rights reserved.`,
        address: isAr ? 'العاشر من رمضان، القاهرة، مصر' : '10th of Ramadan, Cairo, Egypt',
        workHours: isAr ? 'السبت - الخميس: 9 صباحاً - 8 مساءً' : 'Sat - Thu: 9am - 8pm'
    };

    return `<!DOCTYPE html>
<html lang="${lang}" dir="${dir}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${page.metaTitle || page.title}</title>
    <meta name="description" content="${page.metaDescription || ''}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="language-switcher">
        <a href="${switchUrl}" class="lang-btn"><i class="fas fa-globe"></i> ${t.switchLang}</a>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background-color: #0d6efd;">
        <div class="container">
            <a class="navbar-brand" href="${base || '/'}">
                <img src="/images/logo arb ip.png" alt="${t.brandName}" style="height:45px;width:auto;margin-${isAr ? 'left' : 'right'}:10px;">
                <div>
                    <span class="fw-bold">${t.brandName}</span>
                    <small class="d-block" style="font-size:16px;opacity:0.9;margin-top:5px;font-weight:500;">${t.brandSub}</small>
                </div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="${base || '/'}">${t.home}</a></li>
                    <li class="nav-item"><a class="nav-link" href="${base}/about.html">${t.about}</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">${t.services}</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="${base}/arbitration.html">${t.arbitration}</a></li>
                            <li><a class="dropdown-item" href="${base}/trademark.html">${t.trademark}</a></li>
                            <li><a class="dropdown-item" href="${base}/patent.html">${t.patent}</a></li>
                            <li><a class="dropdown-item" href="${base}/copyright.html">${t.copyright}</a></li>
                            <li><a class="dropdown-item" href="${base}/litigation.html">${t.litigation}</a></li>
                            <li><a class="dropdown-item" href="${base}/licensing.html">${t.licensing}</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="${base}/services.html">${t.allServices}</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="${base}/lawyers.html">${t.team}</a></li>
                    <li class="nav-item"><a class="nav-link" href="${base}/blog.html">${t.blog}</a></li>
                    <li class="nav-item"><a class="nav-link" href="${base}/contact.html">${t.contact}</a></li>
                    <li class="nav-item"><a class="nav-link" href="${base}/consultation.html">${t.consultation}</a></li>
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-outline-light btn-sm" href="${base}/client-portal.html"><i class="fas fa-lock me-1"></i>${t.portal}</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <header class="page-header">
        <div class="container text-white text-center">
            <h1 class="display-4">${page.title}</h1>
        </div>
    </header>

    <section class="py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto dynamic-content">
                    ${htmlContent}
                </div>
            </div>
        </div>
    </section>

    <footer class="footer-section py-5 bg-dark text-white">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h5 class="mb-4"><i class="fas fa-balance-scale me-2"></i>${t.brandName}</h5>
                    <p class="text-white-50">${t.brandSub}</p>
                </div>
                <div class="col-lg-4">
                    <h6 class="mb-4">${t.contact}</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i> ${t.address}</li>
                        <li class="mb-2"><i class="fas fa-phone me-2"></i> +20 111257219</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2"></i> walidlegal.ippro@gmail.com</li>
                        <li class="mb-2"><i class="fas fa-clock me-2"></i> ${t.workHours}</li>
                    </ul>
                </div>
                <div class="col-lg-12 mt-3">
                    <hr class="my-3" style="border-color: rgba(255,255,255,0.1);">
                    <p class="small text-white-50 mb-0">${t.copyright}</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
<script src="/js/main.js"></script>
</body>
</html>`;
}

// ============================================================================
// دالة مساعدة: عرض مقال المدونة
// Helper: Render blog post HTML
// ============================================================================
function renderBlogHTML(post, htmlContent, lang) {
    const isAr = lang === 'ar';
    const dir = isAr ? 'rtl' : 'ltr';
    const base = isAr ? '/ar' : '';
    const slug = post.slug.replace(/-ar$/, '');
    const switchUrl = isAr ? '/blog/' + slug : '/ar/blog/' + slug;
    const switchText = isAr ? 'English' : 'العربية';
    const brandName = isAr ? 'وليد أبوالعلا للمحاماة' : 'Walid Abo Al-Ela Law Firm';
    const backText = isAr ? 'العودة إلى المدونة' : 'Back to Blog';
    const byText = isAr ? 'بقلم' : 'by';
    const categoryText = isAr ? 'التصنيف' : 'Category';
    const dateLocale = isAr ? 'ar-EG' : 'en-US';

    const formattedDate = new Date(post.createdAt).toLocaleDateString(dateLocale, {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });

    return `<!DOCTYPE html>
<html lang="${lang}" dir="${dir}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${post.title} - ${brandName}</title>
    <meta name="description" content="${post.excerpt || ''}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="language-switcher">
        <a href="${switchUrl}" class="lang-btn"><i class="fas fa-globe"></i> ${switchText}</a>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background-color: #0d6efd;">
        <div class="container">
            <a class="navbar-brand" href="${base || '/'}">
                <img src="/images/logo arb ip.png" alt="${brandName}" style="height:45px;width:auto;margin-${isAr ? 'left' : 'right'}:10px;">
                <span class="fw-bold">${brandName}</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <header class="page-header">
        <div class="container text-white text-center">
            <h1 class="display-4">${post.title}</h1>
            <p class="lead">${formattedDate} | ${byText} ${post.author}</p>
        </div>
    </header>

    <section class="py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto dynamic-content">
                    ${htmlContent}
                    <hr class="my-5">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <a href="${base}/blog.html" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-${isAr ? 'right' : 'left'} me-2"></i>${backText}
                        </a>
                        <div>
                            <span class="text-muted">${categoryText}: ${post.category || (isAr ? 'غير مصنف' : 'Uncategorized')}</span>
                            <span class="text-muted ms-3"><i class="far fa-eye me-1"></i> ${post.views || 0}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer-section py-5 bg-dark text-white">
        <div class="container">
            <p class="small text-white-50 mb-0 text-center">© ${new Date().getFullYear()} ${brandName}</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
<script src="/js/main.js"></script>
</body>
</html>`;
}

