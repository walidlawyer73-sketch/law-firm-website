// ============================================================================
// إدارة معلومات الاتصال
// Contact info management
// ============================================================================
app.get('/admin/contact', requireAuth, async (req, res) => {
    // جلب معلومات الاتصال بالإنجليزية والعربية
    // Fetch contact info for both languages
    let contactEn = await ContactInfo.findOne({ language: 'en' });
    let contactAr = await ContactInfo.findOne({ language: 'ar' });

    // إذا لم تكن موجودة، إنشاء كائنات فارغة
    // If not found, create empty objects
    if (!contactEn) contactEn = new ContactInfo({ language: 'en' });
    if (!contactAr) contactAr = new ContactInfo({ language: 'ar' });

    res.render('contact', {
        contactEn,
        contactAr,
        lang: req.session.adminLang || 'en'
    });
});

app.post('/admin/contact', requireAuth, async (req, res) => {
    try {
        // تحديث الإنجليزية
        // Update English
        await ContactInfo.findOneAndUpdate(
            { language: 'en' },
            req.body.en,
            { upsert: true, new: true }
        );
        // تحديث العربية
        // Update Arabic
        await ContactInfo.findOneAndUpdate(
            { language: 'ar' },
            req.body.ar,
            { upsert: true, new: true }
        );
        res.redirect('/admin/contact');
    } catch (error) {
        res.status(400).send(error.message);
    }
});

// ============================================================================
// الإعدادات - تغيير كلمة المرور
// Settings - Change admin password
// ============================================================================
app.get('/admin/settings', requireAuth, (req, res) => {
    res.render('settings', {
        error: null,
        success: null,
        lang: req.session.adminLang || 'en'
    });
});

app.post('/admin/settings', requireAuth, async (req, res) => {
    try {
        const user = await User.findById(req.session.userId);
        const { currentPassword, newPassword, confirmPassword } = req.body;

        // التحقق من كلمة المرور الحالية
        // Verify current password
        if (!await user.comparePassword(currentPassword)) {
            return res.render('settings', {
                error: 'Current password is incorrect',
                success: null,
                lang: req.session.adminLang || 'en'
            });
        }

        // التحقق من تطابق كلمتي المرور الجديدتين
        // Verify new passwords match
        if (newPassword !== confirmPassword) {
            return res.render('settings', {
                error: 'New passwords do not match',
                success: null,
                lang: req.session.adminLang || 'en'
            });
        }

        user.password = newPassword;
        await user.save();
        res.render('settings', {
            success: 'Password updated successfully',
            error: null,
            lang: req.session.adminLang || 'en'
        });
    } catch (error) {
        res.status(400).send(error.message);
    }
});

// ============================================================================
// إنشاء حساب الأدمن الافتراضي عند أول تشغيل
// Create default admin user on first startup
// ============================================================================
async function createDefaultAdmin() {
    try {
        if (!process.env.ADMIN_USERNAME || !process.env.ADMIN_PASSWORD) {
            console.warn('⚠️  ADMIN_USERNAME or ADMIN_PASSWORD not set');
            return;
        }

        const adminExists = await User.findOne({ username: process.env.ADMIN_USERNAME });
        if (!adminExists) {
            const admin = new User({
                username: process.env.ADMIN_USERNAME,
                password: process.env.ADMIN_PASSWORD
            });
            await admin.save();
            console.log('✅ Default admin created:', process.env.ADMIN_USERNAME);
        } else {
            console.log('ℹ️  Admin user already exists');
        }
    } catch (error) {
        console.error('❌ Error creating admin:', error.message);
    }
}

// ============================================================================
// معالج 404 - الصفحة غير موجودة
// 404 Handler - Page not found
// ============================================================================
app.use((req, res) => {
    if (req.accepts('html')) {
        return res.status(404).send(`
            <!DOCTYPE html>
            <html><head><title>404 - Not Found</title></head>
            <body style="font-family: Arial; text-align: center; padding: 50px;">
                <h1>404 - Page Not Found</h1>
                <p>The page you are looking for does not exist.</p>
                <a href="/">Go to Home</a>
            <script src="/js/main.js"></script>
</body></html>
        `);
    }
    res.status(404).json({ error: 'Not Found' });
});

// ============================================================================
// بدء تشغيل السيرفر
// Start the server
// ============================================================================
if (process.env.NODE_ENV !== 'production') {
    // بيئة تطوير محلية - تشغيل السيرفر
    // Local development - start the server
    app.listen(port, async () => {
        await createDefaultAdmin();
        console.log('');
        console.log('========================================');
        console.log(`🚀 Server running: http://localhost:${port}`);
        console.log(`🔐 Admin panel:   http://localhost:${port}/admin/login`);
        console.log(`📧 Email status:  ${emailReady ? 'Ready' : 'Not configured'}`);
        console.log('========================================');
        console.log('');
    });
} else {
    // بيئة الإنتاج (Vercel) - فقط إنشاء الأدمن
    // Production (Vercel) - just create admin
    createDefaultAdmin().catch(console.error);
}

// تصدير التطبيق لـ Vercel
// Export app for Vercel
module.exports = app;