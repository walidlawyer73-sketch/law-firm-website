<%- include("./admin/_partials/head", { pageTitle: "Dashboard" }) %>

<div class="card" style="background:linear-gradient(135deg,#0a0a0a 0%,#1a1a1a 100%);color:#fff;border:none;">
  <h1 style="font-size:1.6rem;font-weight:800;margin-bottom:6px;color:#C9A961;">Welcome back, <%= user %> 👋</h1>
  <p style="color:rgba(255,255,255,0.75);margin:0;">كل شيء في متناول يدك. استخدم الـ Sidebar أو الـ Cards أدناه.</p>
</div>

<div class="row g-3">
  <div class="col-lg-3 col-md-6"><a href="/admin/services" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #C9A961;"><i class="fas fa-briefcase fa-2x" style="color:#C9A961;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= services || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Services</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/team" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #C9A961;"><i class="fas fa-users fa-2x" style="color:#C9A961;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= team || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Team Members</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/faqs" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #C9A961;"><i class="fas fa-question-circle fa-2x" style="color:#C9A961;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= faqs || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">FAQs</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/media" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #C9A961;"><i class="fas fa-images fa-2x" style="color:#C9A961;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= media || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Media Files</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/pages" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #17a2b8;"><i class="fas fa-file-alt fa-2x" style="color:#17a2b8;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= pages || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Pages</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/posts" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #17a2b8;"><i class="fas fa-newspaper fa-2x" style="color:#17a2b8;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= posts || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Blog Posts</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/testimonials" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #17a2b8;"><i class="fas fa-quote-right fa-2x" style="color:#17a2b8;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= testimonials || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Testimonials</p></div></a></div>
  <div class="col-lg-3 col-md-6"><a href="/admin/users" style="text-decoration:none;"><div class="card" style="text-align:center;border-top:3px solid #17a2b8;"><i class="fas fa-user-shield fa-2x" style="color:#17a2b8;"></i><h3 style="font-size:2.2rem;margin:10px 0 4px;font-weight:800;color:#212529;"><%= users || 0 %></h3><p style="color:#6C757D;margin:0;font-size:0.85rem;">Users</p></div></a></div>
</div>

<div class="row g-3">
  <div class="col-lg-6"><a href="/admin/messages" style="text-decoration:none;"><div class="card" style="display:flex;align-items:center;gap:20px;border-left:4px solid <%= (newMessages || 0) > 0 ? '#dc3545' : '#28a745' %>;"><div style="width:60px;height:60px;background:<%= (newMessages || 0) > 0 ? '#dc3545' : '#28a745' %>;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;"><i class="fas fa-envelope"></i></div><div style="flex:1;"><h4 style="margin:0 0 4px;font-size:1.1rem;font-weight:700;color:#212529;">Messages</h4><p style="margin:0;color:#6C757D;font-size:0.9rem;"><strong style="color:<%= (newMessages || 0) > 0 ? '#dc3545' : '#28a745' %>;"><%= newMessages || 0 %></strong> new · <strong><%= messages || 0 %></strong> total</p></div><i class="fas fa-arrow-right" style="color:#C9A961;font-size:1.2rem;"></i></div></a></div>
  <div class="col-lg-6"><a href="/admin/site" style="text-decoration:none;"><div class="card" style="display:flex;align-items:center;gap:20px;border-left:4px solid #C9A961;"><div style="width:60px;height:60px;background:#C9A961;color:#000;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;"><i class="fas fa-cog"></i></div><div style="flex:1;"><h4 style="margin:0 0 4px;font-size:1.1rem;font-weight:700;color:#212529;">Site Settings</h4><p style="margin:0;color:#6C757D;font-size:0.9rem;">Edit site name, logo, contact info, and more.</p></div><i class="fas fa-arrow-right" style="color:#C9A961;font-size:1.2rem;"></i></div></a></div>
</div>

<div class="card">
  <h3 style="font-size:1.1rem;font-weight:800;margin:0 0 15px;">Quick Actions</h3>
  <div class="d-flex flex-wrap gap-2">
    <a href="/admin/services/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Service</a>
    <a href="/admin/team/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Team Member</a>
    <a href="/admin/faqs/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New FAQ</a>
    <a href="/admin/posts/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Post</a>
    <a href="/admin/media" class="btn btn-warning"><i class="fas fa-upload me-1"></i>Upload Media</a>
    <a href="/" target="_blank" class="btn btn-secondary"><i class="fas fa-external-link-alt me-1"></i>View Site</a>
  </div>
</div>

</body></html>
