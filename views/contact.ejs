<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lang === 'ar' ? 'تعديل معلومات الاتصال - لوحة التحكم' : 'Edit Contact Info - Admin Panel' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .lang-switch {
            margin-right: 15px;
        }
        .lang-switch a {
            color: white;
            text-decoration: none;
            background: rgba(255,255,255,0.2);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 14px;
        }
        .lang-switch a:hover {
            background: rgba(255,255,255,0.3);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/admin/dashboard">
                <%= lang === 'ar' ? 'لوحة التحكم' : 'Admin Panel' %>
            </a>
            <div class="navbar-nav ms-auto d-flex align-items-center">
                <div class="lang-switch">
                    <% if (lang === 'ar') { %>
                        <a href="/admin/contact?lang=en">English</a>
                    <% } else { %>
                        <a href="/admin/contact?lang=ar">العربية</a>
                    <% } %>
                </div>
                <a class="nav-link" href="/admin/dashboard">
                    <i class="fas fa-tachometer-alt me-1"></i> <%= lang === 'ar' ? 'لوحة التحكم' : 'Dashboard' %>
                </a>
                <a class="nav-link" href="/admin/logout">
                    <i class="fas fa-sign-out-alt me-1"></i> <%= lang === 'ar' ? 'تسجيل الخروج' : 'Logout' %>
                </a>
            </div>
        </div>
    </nav>
    
    <div class="container mt-4">
        <h1 class="mb-4"><%= lang === 'ar' ? 'تعديل معلومات الاتصال' : 'Edit Contact Information' %></h1>
        
        <ul class="nav nav-tabs mb-4" id="languageTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="english-tab" data-bs-toggle="tab" data-bs-target="#english" type="button" role="tab">
                    <%= lang === 'ar' ? 'إنجليزي' : 'English' %>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="arabic-tab" data-bs-toggle="tab" data-bs-target="#arabic" type="button" role="tab">
                    <%= lang === 'ar' ? 'عربي' : 'Arabic' %>
                </button>
            </li>
        </ul>
        
        <form action="/admin/contact" method="POST">
            <div class="tab-content" id="languageTabContent">
                <!-- English Tab -->
                <div class="tab-pane fade show active" id="english" role="tabpanel">
                    <h3 class="mb-3"><%= lang === 'ar' ? 'معلومات الاتصال بالإنجليزية' : 'English Contact Info' %></h3>
                    <div class="mb-3">
                        <label for="en_address" class="form-label"><%= lang === 'ar' ? 'العنوان' : 'Address' %></label>
                        <input type="text" class="form-control" id="en_address" name="en[address]" value="<%= contactEn.address || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="en_phone" class="form-label"><%= lang === 'ar' ? 'رقم الهاتف' : 'Phone' %></label>
                        <input type="text" class="form-control" id="en_phone" name="en[phone]" value="<%= contactEn.phone || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="en_email" class="form-label"><%= lang === 'ar' ? 'البريد الإلكتروني' : 'Email' %></label>
                        <input type="email" class="form-control" id="en_email" name="en[email]" value="<%= contactEn.email || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="en_workingHours" class="form-label"><%= lang === 'ar' ? 'مواعيد العمل' : 'Working Hours' %></label>
                        <input type="text" class="form-control" id="en_workingHours" name="en[workingHours]" value="<%= contactEn.workingHours || '' %>" required>
                    </div>
                </div>
                
                <!-- Arabic Tab -->
                <div class="tab-pane fade" id="arabic" role="tabpanel">
                    <h3 class="mb-3"><%= lang === 'ar' ? 'معلومات الاتصال بالعربية' : 'Arabic Contact Info' %></h3>
                    <div class="mb-3">
                        <label for="ar_address" class="form-label"><%= lang === 'ar' ? 'العنوان' : 'Address' %></label>
                        <input type="text" class="form-control" id="ar_address" name="ar[address]" value="<%= contactAr.address || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="ar_phone" class="form-label"><%= lang === 'ar' ? 'رقم الهاتف' : 'Phone' %></label>
                        <input type="text" class="form-control" id="ar_phone" name="ar[phone]" value="<%= contactAr.phone || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="ar_email" class="form-label"><%= lang === 'ar' ? 'البريد الإلكتروني' : 'Email' %></label>
                        <input type="email" class="form-control" id="ar_email" name="ar[email]" value="<%= contactAr.email || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="ar_workingHours" class="form-label"><%= lang === 'ar' ? 'مواعيد العمل' : 'Working Hours' %></label>
                        <input type="text" class="form-control" id="ar_workingHours" name="ar[workingHours]" value="<%= contactAr.workingHours || '' %>" required>
                    </div>
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary mt-3">
                <i class="fas fa-save me-2"></i> <%= lang === 'ar' ? 'حفظ التغييرات' : 'Save Changes' %>
            </button>
            <a href="/admin/dashboard" class="btn btn-secondary mt-3">
                <i class="fas fa-times me-2"></i> <%= lang === 'ar' ? 'إلغاء' : 'Cancel' %>
            </a>
        </form>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>