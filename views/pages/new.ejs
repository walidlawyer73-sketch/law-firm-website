<%- include("../admin/_partials/head", { pageTitle: "New Page" }) %>
<div class="container">
  <div class="card">
    <h2><i class="fas fa-plus-circle me-2"></i>Add Page</h2>
    <form method="POST" action="/admin/pages" enctype="multipart/form-data">
      <div class="row">
        <div class="col-md-8 mb-3"><label class="form-label">Title *</label><input class="form-control" name="title" required></div>
        <div class="col-md-4 mb-3"><label class="form-label">Slug *</label><input class="form-control" name="slug" required placeholder="e.g. about-us"></div>
        <div class="col-12 mb-3"><label class="form-label">Content (Markdown) *</label><textarea class="form-control" name="content" rows="15" required placeholder="## Heading&#10;&#10;Paragraph text...&#10;&#10;- List item 1&#10;- List item 2"></textarea></div>
        <div class="col-md-6 mb-3"><label class="form-label">Meta Title</label><input class="form-control" name="metaTitle"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Meta Description</label><textarea class="form-control" name="metaDescription" rows="2"></textarea></div>
        <div class="col-md-4 mb-3"><label class="form-label">Language</label>
          <select class="form-control" name="language">
            <option value="en">English</option>
            <option value="ar">العربية</option>
          </select>
        </div>
        <div class="col-md-4 mb-3 pt-4">
          <label class="form-check"><input class="form-check-input" type="checkbox" name="published" checked><span class="form-check-label">Published</span></label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Create Page</button>
      <a href="/admin/pages" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>
</body></html>
