<%- include("../admin/_partials/head", { pageTitle: "Pages" }) %>
<div class="container">
  <div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><i class="fas fa-file-alt me-2"></i>Pages (<%= pages.length %>)</h2>
      <div>
        <a href="/admin/pages/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Page</a>
        <a href="/admin/dashboard" class="btn btn-secondary">Back</a>
      </div>
    </div>
    <% if (pages.length === 0) { %>
      <div class="alert alert-info">لا توجد صفحات حتى الآن. <a href="/admin/pages/new">أنشئ صفحة</a>.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Title</th>
              <th>Slug</th>
              <th style="width:80px;">Lang</th>
              <th style="width:100px;">Published</th>
              <th style="width:130px;">Updated</th>
              <th style="width:140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
          <% pages.forEach(function(p) { %>
            <tr>
              <td><strong><%= p.title %></strong></td>
              <td><code>/<%= p.slug %></code></td>
              <td><span class="badge <%= p.language === 'ar' ? 'bg-success' : 'bg-info' %>"><%= (p.language || 'en').toUpperCase() %></span></td>
              <td>
                <% if (p.published) { %><span class="badge bg-success">Yes</span>
                <% } else { %><span class="badge bg-secondary">No</span><% } %>
              </td>
              <td style="font-size:0.8rem;"><%= new Date(p.updatedAt || p.createdAt).toLocaleDateString("en-US") %></td>
              <td>
                <a href="/<%= p.slug %>" target="_blank" class="btn btn-sm btn-info" title="Preview"><i class="fas fa-eye"></i></a>
                <a href="/admin/pages/<%= p._id %>/edit" class="btn btn-sm btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                <form method="POST" action="/admin/pages/<%= p._id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this page?')">
                  <button class="btn btn-sm btn-danger" type="submit" title="Delete"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
</body></html>
