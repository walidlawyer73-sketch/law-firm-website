<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lang === 'ar' ? 'تعديل الصفحة - لوحة التحكم' : 'Edit Page - Admin Panel' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .lang-switch {
            margin-right: 15px;
        }
        .lang-switch a {
            color: white;
            text-decoration: none;
            background: rgba(255,255,255,0.2);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 14px;
        }
        .lang-switch a:hover {
            background: rgba(255,255,255,0.3);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/admin/dashboard">
                <%= lang === 'ar' ? 'لوحة التحكم' : 'Admin Panel' %>
            </a>
            <div class="navbar-nav ms-auto d-flex align-items-center">
                <div class="lang-switch">
                    <% if (lang === 'ar') { %>
                        <a href="/admin/pages/<%= page._id %>/edit?lang=en">English</a>
                    <% } else { %>
                        <a href="/admin/pages/<%= page._id %>/edit?lang=ar">العربية</a>
                    <% } %>
                </div>
                <a class="nav-link" href="/admin/dashboard">
                    <i class="fas fa-tachometer-alt me-1"></i> <%= lang === 'ar' ? 'لوحة التحكم' : 'Dashboard' %>
                </a>
                <a class="nav-link" href="/admin/logout">
                    <i class="fas fa-sign-out-alt me-1"></i> <%= lang === 'ar' ? 'تسجيل الخروج' : 'Logout' %>
                </a>
            </div>
        </div>
    </nav>
    
    <div class="container mt-4">
        <h1><%= lang === 'ar' ? 'تعديل الصفحة' : 'Edit Page' %></h1>
        <form action="/admin/pages/<%= page._id %>?_method=PUT" method="POST">
            <div class="mb-3">
                <label for="title" class="form-label"><%= lang === 'ar' ? 'العنوان' : 'Title' %></label>
                <input type="text" class="form-control" id="title" name="title" value="<%= page.title %>" required>
            </div>
            <div class="mb-3">
                <label for="slug" class="form-label"><%= lang === 'ar' ? 'الرابط (Slug)' : 'Slug (URL)' %></label>
                <input type="text" class="form-control" id="slug" name="slug" value="<%= page.slug %>" required>
            </div>
            <div class="mb-3">
                <label for="content" class="form-label"><%= lang === 'ar' ? 'المحتوى' : 'Content' %></label>
                <textarea class="form-control" id="content" name="content" rows="10" required><%= page.content %></textarea>
            </div>
            <div class="mb-3">
                <label for="metaTitle" class="form-label"><%= lang === 'ar' ? 'العنوان لتحسين محركات البحث (SEO)' : 'Meta Title (SEO)' %></label>
                <input type="text" class="form-control" id="metaTitle" name="metaTitle" value="<%= page.metaTitle || '' %>">
            </div>
            <div class="mb-3">
                <label for="metaDescription" class="form-label"><%= lang === 'ar' ? 'الوصف لتحسين محركات البحث (SEO)' : 'Meta Description (SEO)' %></label>
                <textarea class="form-control" id="metaDescription" name="metaDescription" rows="3"><%= page.metaDescription || '' %></textarea>
            </div>
            <div class="mb-3">
                <label for="language" class="form-label"><%= lang === 'ar' ? 'اللغة' : 'Language' %></label>
                <select class="form-control" id="language" name="language">
                    <option value="en" <%= page.language === 'en' ? 'selected' : '' %>><%= lang === 'ar' ? 'إنجليزي' : 'English' %></option>
                    <option value="ar" <%= page.language === 'ar' ? 'selected' : '' %>><%= lang === 'ar' ? 'عربي' : 'Arabic' %></option>
                </select>
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="published" name="published" <%= page.published ? 'checked' : '' %>>
                <label class="form-check-label" for="published"><%= lang === 'ar' ? 'منشور' : 'Published' %></label>
            </div>
            <button type="submit" class="btn btn-primary"><%= lang === 'ar' ? 'تحديث الصفحة' : 'Update Page' %></button>
            <a href="/admin/pages" class="btn btn-secondary"><%= lang === 'ar' ? 'إلغاء' : 'Cancel' %></a>
        </form>
    </div>
</body>
</html>