<%- include("../admin/_partials/head", { pageTitle: "Edit Post" }) %>
<div class="container">
  <div class="card">
    <h2><i class="fas fa-edit me-2"></i>Edit Post: <%= post.title %></h2>
    <form method="POST" action="/admin/posts/<%= post._id %>?_method=PUT" enctype="multipart/form-data">
      <div class="row">
        <div class="col-md-8 mb-3"><label class="form-label">Title *</label><input class="form-control" name="title" value="<%= post.title %>" required></div>
        <div class="col-md-4 mb-3"><label class="form-label">Slug *</label><input class="form-control" name="slug" value="<%= post.slug %>" required></div>
        <div class="col-12 mb-3"><label class="form-label">Excerpt</label><textarea class="form-control" name="excerpt" rows="2"><%= post.excerpt || '' %></textarea></div>
        <div class="col-12 mb-3"><label class="form-label">Content (Markdown) *</label><textarea class="form-control" name="content" rows="15" required><%= post.content %></textarea></div>
        <div class="col-md-4 mb-3"><label class="form-label">Author</label><input class="form-control" name="author" value="<%= post.author %>"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Category</label><input class="form-control" name="category" value="<%= post.category || '' %>"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Language</label>
          <select class="form-control" name="language">
            <option value="en" <%= post.language === 'en' ? 'selected' : '' %>>English</option>
            <option value="ar" <%= post.language === 'ar' ? 'selected' : '' %>>العربية</option>
          </select>
        </div>
        <div class="col-md-4 mb-3 pt-4">
          <label class="form-check"><input class="form-check-input" type="checkbox" name="published" <%= post.published ? 'checked' : '' %>><span class="form-check-label">Published</span></label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/admin/posts" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>
</body></html>
