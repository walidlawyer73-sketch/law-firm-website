<%- include("../admin/_partials/head", { pageTitle: "Blog Posts" }) %>
<div class="container">
  <div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><i class="fas fa-newspaper me-2"></i>Blog Posts (<%= posts.length %>)</h2>
      <div>
        <a href="/admin/posts/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Post</a>
        <a href="/admin/dashboard" class="btn btn-secondary">Back</a>
      </div>
    </div>
    <% if (posts.length === 0) { %>
      <div class="alert alert-info">لا توجد مقالات حتى الآن. <a href="/admin/posts/new">أنشئ مقالاً</a>.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Title</th>
              <th>Slug</th>
              <th style="width:100px;">Category</th>
              <th style="width:80px;">Lang</th>
              <th style="width:100px;">Published</th>
              <th style="width:80px;">Views</th>
              <th style="width:140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
          <% posts.forEach(function(p) { %>
            <tr>
              <td><strong><%= p.title %></strong></td>
              <td><code>/blog/<%= p.slug %></code></td>
              <td><%= p.category || '—' %></td>
              <td><span class="badge <%= p.language === 'ar' ? 'bg-success' : 'bg-info' %>"><%= (p.language || 'en').toUpperCase() %></span></td>
              <td><% if (p.published) { %><span class="badge bg-success">Yes</span><% } else { %><span class="badge bg-secondary">No</span><% } %></td>
              <td><%= p.views || 0 %></td>
              <td>
                <a href="<%= p.language === 'ar' ? '/ar/blog/' : '/blog/' %><%= p.slug.replace(/-ar$/, '') %>" target="_blank" class="btn btn-sm btn-info" title="Preview"><i class="fas fa-eye"></i></a>
                <a href="/admin/posts/<%= p._id %>/edit" class="btn btn-sm btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                <form method="POST" action="/admin/posts/<%= p._id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this post?')">
                  <button class="btn btn-sm btn-danger" type="submit" title="Delete"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
</body></html>
