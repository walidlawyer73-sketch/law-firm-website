<%- include("../admin/_partials/head", { pageTitle: "New Post" }) %>
<div class="container">
  <div class="card">
    <h2><i class="fas fa-plus-circle me-2"></i>Add Blog Post</h2>
    <form method="POST" action="/admin/posts" enctype="multipart/form-data">
      <div class="row">
        <div class="col-md-8 mb-3"><label class="form-label">Title *</label><input class="form-control" name="title" required></div>
        <div class="col-md-4 mb-3"><label class="form-label">Slug *</label><input class="form-control" name="slug" required placeholder="e.g. my-new-post"></div>
        <div class="col-12 mb-3"><label class="form-label">Excerpt</label><textarea class="form-control" name="excerpt" rows="2"></textarea></div>
        <div class="col-12 mb-3"><label class="form-label">Content (Markdown) *</label><textarea class="form-control" name="content" rows="15" required></textarea></div>
        <div class="col-md-4 mb-3"><label class="form-label">Author</label><input class="form-control" name="author" value="Walid Abo Al-Ela"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Category</label><input class="form-control" name="category" placeholder="e.g. Intellectual Property"></div>
        <div class="col-md-4 mb-3"><label class="form-label">Language</label>
          <select class="form-control" name="language">
            <option value="en">English</option>
            <option value="ar">العربية</option>
          </select>
        </div>
        <div class="col-md-4 mb-3 pt-4">
          <label class="form-check"><input class="form-check-input" type="checkbox" name="published" checked><span class="form-check-label">Published</span></label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Create Post</button>
      <a href="/admin/posts" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>
</body></html>
