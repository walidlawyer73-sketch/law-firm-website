<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>نسيت كلمة المرور - لوحة التحكم</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .card-forgot {
      background: #fff;
      border-radius: 16px;
      padding: 40px 35px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
    }
    .card-forgot h2 {
      color: #212529;
      font-weight: 800;
      text-align: center;
      margin-bottom: 10px;
    }
    .card-forgot .subtitle {
      color: #6C757D;
      text-align: center;
      font-size: 0.9rem;
      margin-bottom: 30px;
    }
    .icon-header {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, #C9A961, #A88947);
      color: #000;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      margin: 0 auto 20px;
    }
    .form-control {
      padding: 12px 16px;
      border: 2px solid #E9ECEF;
      border-radius: 10px;
      font-size: 0.95rem;
    }
    .form-control:focus {
      border-color: #C9A961;
      box-shadow: 0 0 0 4px rgba(201, 169, 97, 0.15);
    }
    .btn-gold {
      background: linear-gradient(135deg, #C9A961, #A88947);
      color: #000;
      border: none;
      padding: 13px;
      border-radius: 10px;
      font-weight: 700;
      width: 100%;
      transition: all 0.3s;
    }
    .btn-gold:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(201, 169, 97, 0.4);
      color: #000;
    }
    .alert {
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 0.88rem;
    }
    .back-link {
      text-align: center;
      margin-top: 20px;
      font-size: 0.88rem;
    }
    .back-link a {
      color: #A88947;
      text-decoration: none;
      font-weight: 600;
    }
    .back-link a:hover {
      color: #000;
    }
  </style>
</head>
<body>
  <div class="card-forgot">
    <div class="icon-header">
      <i class="fas fa-key"></i>
    </div>
    <h2>نسيت كلمة المرور؟</h2>
    <p class="subtitle">أدخل اسم المستخدم أو البريد الإلكتروني وسنرسل لك بيانات الدخول الجديدة</p>

    <% if (error) { %>
      <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success">
        <i class="fas fa-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <form method="POST" action="/admin/forgot-password">
      <div class="mb-3">
        <label class="form-label fw-bold mb-2">اسم المستخدم أو البريد الإلكتروني</label>
        <input 
          type="text" 
          name="identifier" 
          class="form-control" 
          placeholder="مثال: admin أو your@email.com"
          required
          autofocus
        >
      </div>
      <button type="submit" class="btn-gold">
        <i class="fas fa-paper-plane me-2"></i>إرسال بيانات الدخول
      </button>
    </form>

    <div class="back-link">
      <a href="/admin/login"><i class="fas fa-arrow-right me-1"></i>العودة لتسجيل الدخول</a>
    </div>
  </div>
</body>
</html>
