<%- include("../_partials/head", { pageTitle: "Edit FAQ" }) %>
<div class="container">
  <div class="card">
    <h2><i class="fas fa-edit me-2"></i>Edit FAQ</h2>
    <form method="POST" action="/admin/faqs/<%= faq._id %>?_method=PUT">
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Question (English) *</label><input class="form-control" name="questionEn" value="<%= faq.questionEn %>" required></div>
        <div class="col-md-6 mb-3"><label class="form-label">Question (Arabic) *</label><input class="form-control" name="questionAr" value="<%= faq.questionAr %>" required dir="rtl"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Answer (English) *</label><textarea class="form-control" name="answerEn" rows="5" required><%= faq.answerEn %></textarea></div>
        <div class="col-md-6 mb-3"><label class="form-label">Answer (Arabic) *</label><textarea class="form-control" name="answerAr" rows="5" required dir="rtl"><%= faq.answerAr %></textarea></div>
        <div class="col-md-4 mb-3"><label class="form-label">Category</label>
          <select class="form-control" name="category">
            <% ['general','ip','arbitration','corporate','contracts'].forEach(c => { %>
              <option value="<%= c %>" <%= faq.category === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4 mb-3"><label class="form-label">Order</label><input type="number" class="form-control" name="order" value="<%= faq.order %>"></div>
        <div class="col-md-4 mb-3 pt-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="published" <%= faq.published ? 'checked' : '' %>><span class="form-check-label">Published</span></label></div>
      </div>
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/admin/faqs" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>
</body></html>
