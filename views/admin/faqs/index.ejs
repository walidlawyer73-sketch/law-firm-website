<%- include("../_partials/head", { pageTitle: "FAQs" }) %>
<div class="container">
  <div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><i class="fas fa-question-circle me-2"></i>FAQs (<%= faqs.length %>)</h2>
      <div>
        <a href="/admin/faqs/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add FAQ</a>
        <a href="/admin/dashboard" class="btn btn-secondary">Back</a>
      </div>
    </div>
    <% if (faqs.length === 0) { %>
      <div class="alert alert-info">No FAQs yet. <a href="/admin/faqs/new">Create one</a>.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-dark">
            <tr><th>Question EN</th><th>Question AR</th><th>Category</th><th>Order</th><th>Published</th><th>Actions</th></tr>
          </thead>
          <tbody>
          <% faqs.forEach(f => { %>
            <tr>
              <td><%= f.questionEn %></td>
              <td dir="rtl"><%= f.questionAr %></td>
              <td><span class="badge bg-info"><%= f.category %></span></td>
              <td><%= f.order %></td>
              <td><% if (f.published) { %><span class="badge bg-success">Yes</span><% } else { %><span class="badge bg-secondary">No</span><% } %></td>
              <td>
                <a href="/admin/faqs/<%= f._id %>/edit" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                <form method="POST" action="/admin/faqs/<%= f._id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this FAQ?')">
                  <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
</body></html>
