<%- include("../_partials/head", { pageTitle: "Edit User" }) %>
<div class="container">
  <div class="card">
    <h2><i class="fas fa-user-edit me-2"></i>Edit User: <%= user.username %></h2>
    <% if (isSelf) { %><div class="alert alert-info"><i class="fas fa-info-circle me-1"></i> هذا حسابك أنت. لا يمكنك تغيير دورك أو إلغاء تفعيلك.</div><% } %>
    <form method="POST" action="/admin/users/<%= user._id %>?_method=PUT">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Username</label>
          <input class="form-control" value="<%= user.username %>" disabled>
          <small class="text-muted">Username cannot be changed</small>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">New Password</label>
          <input type="password" class="form-control" name="password" minlength="8" placeholder="اتركه فارغاً للإبقاء على الحالي">
          <small class="text-muted">فقط إن أردت تغيير كلمة المرور (8+ أحرف)</small>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Display Name</label>
          <input class="form-control" name="displayName" value="<%= user.displayName || '' %>">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control" name="email" value="<%= user.email || '' %>">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Role</label>
          <select class="form-control" name="role" <%= isSelf ? 'disabled' : '' %>>
            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin (full access)</option>
            <option value="editor" <%= user.role === 'editor' ? 'selected' : '' %>>Editor (manage content)</option>
            <option value="viewer" <%= user.role === 'viewer' ? 'selected' : '' %>>Viewer (read only)</option>
          </select>
          <% if (isSelf) { %><input type="hidden" name="role" value="<%= user.role %>"><% } %>
        </div>
        <div class="col-md-6 mb-3 pt-4">
          <label class="form-check">
            <input class="form-check-input" type="checkbox" name="isActive" <%= user.isActive ? 'checked' : '' %> <%= isSelf ? 'disabled' : '' %>>
            <span class="form-check-label">Active (يمكن تسجيل الدخول)</span>
          </label>
          <% if (isSelf) { %><input type="hidden" name="isActive" value="on"><% } %>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/admin/users" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>
</body></html>
