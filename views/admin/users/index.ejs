<%- include("../_partials/head", { pageTitle: "Users" }) %>
<div class="container">
  <div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><i class="fas fa-users-cog me-2"></i>Users (<%= users.length %>)</h2>
      <div>
        <a href="/admin/users/new" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add User</a>
        <a href="/admin/dashboard" class="btn btn-secondary">Back</a>
      </div>
    </div>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
          <tr><th>Username</th><th>Display Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last Login</th><th>Actions</th></tr>
        </thead>
        <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td>
              <strong><%= u.username %></strong>
              <% if (u._id.toString() === currentUserId) { %><span class="badge bg-info ms-1">You</span><% } %>
            </td>
            <td><%= u.displayName || '-' %></td>
            <td><%= u.email || '-' %></td>
            <td>
              <% if (u.role === 'admin') { %><span class="badge bg-danger">Admin</span>
              <% } else if (u.role === 'editor') { %><span class="badge bg-warning text-dark">Editor</span>
              <% } else { %><span class="badge bg-secondary">Viewer</span><% } %>
            </td>
            <td><% if (u.isActive) { %><span class="badge bg-success">Active</span><% } else { %><span class="badge bg-secondary">Inactive</span><% } %></td>
            <td style="font-size:0.82rem;"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString() : '-' %></td>
            <td>
              <a href="/admin/users/<%= u._id %>/edit" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
              <% if (u._id.toString() !== currentUserId) { %>
                <form method="POST" action="/admin/users/<%= u._id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete user <%= u.username %>? This cannot be undone.')">
                  <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</body></html>
