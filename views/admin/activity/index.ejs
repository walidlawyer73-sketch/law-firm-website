<%- include("../_partials/head", { pageTitle: "Activity Log" }) %>
<div class="container">
  <div class="card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><i class="fas fa-history me-2"></i>Activity Log (<%= total %>)</h2>
      <a href="/admin/dashboard" class="btn btn-secondary">Back</a>
    </div>
    <p style="color:#6C757D;font-size:0.85rem;margin-bottom:20px;">
      <i class="fas fa-info-circle me-1"></i>
      يتم حذف السجلات تلقائياً بعد 90 يوماً. الصفحة تعرض آخر 50 حدثاً.
    </p>

    <% if (logs.length === 0) { %>
      <div class="alert alert-info">لا توجد سجلات بعد. ابدأ بتعديل خدمة أو مقال لتظهر هنا.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle" style="font-size:0.88rem;">
          <thead class="table-dark">
            <tr>
              <th style="width:140px;">التاريخ</th>
              <th style="width:100px;">المستخدم</th>
              <th style="width:100px;">الإجراء</th>
              <th style="width:120px;">النموذج</th>
              <th>العنصر</th>
              <th style="width:130px;">IP</th>
            </tr>
          </thead>
          <tbody>
          <% logs.forEach(function(log) { %>
            <tr>
              <td style="font-size:0.78rem;color:#6C757D;">
                <%= new Date(log.createdAt).toLocaleString((typeof lang !== "undefined" && lang === "ar" ? "ar-EG" : "en-US"), { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) %>
              </td>
              <td><strong><%= log.username %></strong></td>
              <td>
                <% if (log.action === 'create') { %><span class="badge bg-success">Create</span>
                <% } else if (log.action === 'update') { %><span class="badge bg-warning text-dark">Update</span>
                <% } else if (log.action === 'delete') { %><span class="badge bg-danger">Delete</span>
                <% } else if (log.action === 'login') { %><span class="badge bg-info">Login</span>
                <% } else if (log.action === 'upload') { %><span class="badge bg-primary">Upload</span>
                <% } else { %><span class="badge bg-secondary"><%= log.action %></span><% } %>
              </td>
              <td><code style="font-size:0.75rem;"><%= log.model %></code></td>
              <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= log.modelLabel || '' %>">
                <%= log.modelLabel || '—' %>
              </td>
              <td style="font-size:0.75rem;color:#ADB5BD;"><%= log.ip || '—' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
        <nav style="margin-top:20px;">
          <ul class="pagination justify-content-center">
            <% if (page > 1) { %>
              <li class="page-item"><a class="page-link" href="/admin/activity?page=<%= page - 1 %>">‹ السابق</a></li>
            <% } %>
            <li class="page-item disabled"><span class="page-link">صفحة <%= page %> من <%= totalPages %></span></li>
            <% if (page < totalPages) { %>
              <li class="page-item"><a class="page-link" href="/admin/activity?page=<%= page + 1 %>">التالي ›</a></li>
            <% } %>
          </ul>
        </nav>
      <% } %>
    <% } %>
  </div>
</div>
</body></html>
