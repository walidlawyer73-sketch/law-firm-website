<%- include("../_partials/head", { pageTitle: "New Team Member" }) %>
<div class="container">
  <div class="card">
    <h2><i class="fas fa-user-plus me-2"></i>Add Team Member</h2>
    <form method="POST" action="/admin/team" enctype="multipart/form-data">
      <div class="section-title">Basic Info</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Name (English) *</label><input class="form-control" name="nameEn" required></div>
        <div class="col-md-6 mb-3"><label class="form-label">Name (Arabic) *</label><input class="form-control" name="nameAr" required dir="rtl"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Slug (auto from EN name)</label><input class="form-control" name="slug" placeholder="leave blank"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Order</label><input type="number" class="form-control" name="order" value="0"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Role (English)</label><input class="form-control" name="roleEn"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Role (Arabic)</label><input class="form-control" name="roleAr" dir="rtl"></div>
      </div>
      <div class="section-title">Bio</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Bio (English)</label><textarea class="form-control" name="bioEn" rows="4"></textarea></div>
        <div class="col-md-6 mb-3"><label class="form-label">Bio (Arabic)</label><textarea class="form-control" name="bioAr" rows="4" dir="rtl"></textarea></div>
      </div>
      <div class="section-title">Contact</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Email</label><input type="email" class="form-control" name="email"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Phone</label><input class="form-control" name="phone"></div>
      </div>
      <div class="section-title">Specialties (comma-separated)</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Specialties (EN)</label><input class="form-control" name="specialtiesEn" placeholder="IP, Arbitration, Corporate"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Specialties (AR)</label><input class="form-control" name="specialtiesAr" placeholder="ملكية فكرية، تحكيم" dir="rtl"></div>
      </div>
      <div class="section-title">Social</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">LinkedIn</label><input class="form-control" name="social_linkedin"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Twitter</label><input class="form-control" name="social_twitter"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Facebook</label><input class="form-control" name="social_facebook"></div>
        <div class="col-md-6 mb-3"><label class="form-label">WhatsApp</label><input class="form-control" name="social_whatsapp"></div>
        <div class="col-md-6 mb-3"><label class="form-label">Telegram</label><input class="form-control" name="social_telegram"></div>
      </div>
      <div class="section-title">Photo & Status</div>
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Photo</label><input type="file" class="form-control" name="image" accept="image/*"></div>
        <div class="col-md-6 mb-3 pt-4">
          <label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="isFeatured"><span class="form-check-label">Featured</span></label>
          <label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="isActive" checked><span class="form-check-label">Active</span></label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary mt-3">Create</button>
      <a href="/admin/team" class="btn btn-secondary mt-3">Cancel</a>
    </form>
  </div>
</div>
</body></html>
